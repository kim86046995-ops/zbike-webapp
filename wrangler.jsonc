{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zbike-webapp",
  "compatibility_date": "2026-01-30",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webapp-production",
      "database_id": "eed661bb-b71a-4113-bf9e-37d047d8c760"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_ID_CARDS",
      "bucket_name": "zbike-id-cards"
    },
    {
      "binding": "R2_BACKUPS",
      "bucket_name": "zbike-backups"
    }
  ],
  // Cron 트리거: 매일 오전 3시 (KST 기준 자정)에 자동 백업
  "triggers": {
    "crons": ["0 18 * * *"]  // UTC 18:00 = KST 03:00 (다음날)
  }
  // SMS 환경변수는 Cloudflare Pages Secrets로 관리됩니다
  // SMS_ENABLED, SMS_TEST_MODE, SMS_AWS_LAMBDA_URL, ADMIN_PHONE
}