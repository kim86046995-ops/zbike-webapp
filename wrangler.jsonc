{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zbike-webapp",
  "compatibility_date": "2026-01-30",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webapp-production",
      "database_id": "eed661bb-b71a-4113-bf9e-37d047d8c760"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_ID_CARDS",
      "bucket_name": "zbike-id-cards"
    },
    {
      "binding": "R2_BACKUPS",
      "bucket_name": "zbike-backups"
    }
  ]
  // Cron Triggers는 Cloudflare Dashboard에서 설정해야 합니다
  // Pages > Settings > Functions > Cron Triggers
  // Schedule: "0 18 * * *" (매일 UTC 18:00 = KST 03:00)
  // SMS 환경변수는 Cloudflare Pages Secrets로 관리됩니다
  // SMS_ENABLED, SMS_TEST_MODE, SMS_AWS_LAMBDA_URL, ADMIN_PHONE
}